{
  "name": "levantamento-tecnico-veiculos",
  "version": "1.0.0",
  "private": true,
  "description": "Coleta local de dados técnicos de veículos e exportação XLSX.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-static.cjs",
    "start": "node scripts/serve.cjs",
    "vendor": "node scripts/vendor.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
